/* 页面整体容器 */
.page-container {
  background-color: #f5f5f7;
  min-height: 100%;
}

/* 固定顶部的头部容器 */
.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 头像和昵称区域 */
.head-box {
  display: flex;
  align-items: center;
  padding: 15rpx 30rpx;
  box-sizing: border-box;
  justify-content: flex-start; /* 整体内容居左 */
}

.head-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #fbdbdc;
  margin-right: 20rpx;
  margin: 0; /* 清除图片默认margin */
  display: block;
}

.name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-left: 20rpx; /* 与头像保持间距 */
}

/* 可滚动内容区域 - 增加顶部间距避开固定头部 */
.scroll-content {
  padding-top: 110rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  box-sizing: border-box;
}

/* 历史记录模块容器 */
.section {
  margin: 20rpx 0 30rpx;
}

/* 模块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 15rpx;
  padding-left: 5rpx;
}

/* 卡片条目 - 拉长宽度与屏幕同宽 */
.card-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 25rpx 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
  width: 100%;
  box-sizing: border-box;
}

.card-item:hover {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transform: translateY(-1rpx);
}

/* 卡片图标 */
.card-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* 卡片内容区 */
.card-content {
  flex: 1;
  min-width: 0;
}

/* 卡片标题 */
.card-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 卡片描述 */
.card-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 右侧箭头 */
.arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 15rpx;
  flex-shrink: 0;
  opacity: 0.7;
}

/* 头像选择按钮 - 融合背景 + 左侧margin为0 */
.avatar-btn {
  /* 去除按钮默认样式 */
  background: transparent;
  border: none;
  padding: 0;
  margin: 0; /* 清除所有方向margin */
  margin-left: 0 !important; /* 强制左侧margin为0，优先级最高 */
  outline: none;
  line-height: normal;
  /* 按钮内部布局 */
  display: flex;
  justify-content: flex-start;
  align-items: center;
  /* 去除点击反馈 */
  -webkit-tap-highlight-color: transparent;
}

/* 彻底去除按钮默认伪元素样式 */
.avatar-btn::after {
  content: none;
}