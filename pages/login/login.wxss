/* pages/login/login.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  /* 渐变背景提升层次感 */
  background: linear-gradient(135deg, #f5f7fa 0%, #e4eaf1 100%);
  padding: 0 30rpx;
  /* 轻微背景纹理 */
  background-image: 
    radial-gradient(rgba(128, 128, 128, 0.05) 1px, transparent 1px),
    radial-gradient(rgba(128, 128, 128, 0.05) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
  background-position: 0 0, 20rpx 20rpx;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
  /* 添加轻微动画效果 */
  animation: fadeIn 0.6s ease-out;
}

/* logo优化 */
.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 45rpx;
  border-radius: 50%;
  /* 精致阴影效果 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  /* 背景填充（图片未加载时显示） */
  background-color: #fff;
  padding: 10rpx;
  /* 轻微缩放动画 */
  transition: transform 0.3s ease;
}

.logo:hover {
  transform: scale(1.03);
}

/* 标题优化 */
.title {
  font-size: 40rpx;
  color: #2c3e50;
  font-weight: 600;
  /* 文字阴影增强质感 */
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  letter-spacing: 2rpx;
  position: relative;
}

.title::after {
  content: '';
  position: absolute;
  bottom: -15rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 6rpx;
  background: #07c160;
  border-radius: 3rpx;
}

/* 登录按钮优化 */
.login-btn {
  width: 60%;               /* 按钮宽度，可按需调整 */
  height: 96rpx;            /* 按钮高度 */
  line-height: 1;           /* 重置行高（Flex 模式下可不设） */
  font-size: 32rpx;         /* 文字大小 */
  color: #fff;              /* 文字颜色 */
  border-radius: 48rpx;     /* 圆角 */
  /* Flex 居中（推荐） */
  display: flex;           
  justify-content: center; 
  align-items: center;     
  /* 渐变背景+阴影，提升质感 */
  background: linear-gradient(90deg, #07c160, #06b056);
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.2);
  /* 移除默认边框 */
  border: none;
}

/* 按钮交互效果 */
.login-btn:not([disabled]):hover {
  transform: translateY(-2rpx);
  box-shadow: 0 10rpx 20rpx rgba(7, 193, 96, 0.3);
}
.login-btn:active {
  opacity: 0.8;             /* 点击时透明度降低 */
  transform: scale(0.98);   /* 轻微缩放 */
}
.login-btn:not([disabled]):active {
  transform: translateY(0);
  box-shadow: 0 5rpx 10rpx rgba(7, 193, 96, 0.2);
}

/* 加载状态按钮调整 */
.login-btn[loading] {
  background: #07c160;
  box-shadow: 0 5rpx 15rpx rgba(7, 193, 96, 0.2);
}

/* 提示信息优化 */
.login-tip {
  font-size: 28rpx;
  color: #ff4d4f;
  text-align: center;
  padding: 15rpx 20rpx;
  border-radius: 8rpx;
  /* 轻微背景衬托 */
  background-color: rgba(255, 77, 79, 0.05);
  /* 动画过渡 */
  opacity: 0;
  transform: translateY(10rpx);
  animation: showTip 0.3s ease-out forwards;
  max-width: 100%;
  word-break: break-word;
  margin-top: 10rpx;
}

/* 动画定义 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes showTip {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 底部装饰元素 */
.container::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.02) 100%);
  pointer-events: none;
}
  