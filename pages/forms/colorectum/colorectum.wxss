/* pages/colorectal/colorectal.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
}

.form-header {
  padding: 30rpx 0;
  text-align: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.question-group {
  display: flex;
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.question-number {
  font-size: 30rpx;
  font-weight: bold;
  color: #1677ff;
  margin-right: 15rpx;
  min-width: 40rpx;
}

.question-content {
  flex: 1;
}

.question-text {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #555;
  padding: 10rpx 0;
}

.radio-item radio {
  margin-right: 15rpx;
  transform: scale(1.2);
}

.conditional-input {
  margin-left: 10rpx;
  padding: 12rpx 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  flex: 1;
  min-width: 300rpx;
}

.sub-question {
  display: flex;
  margin: 30rpx 0 30rpx 20rpx;
  padding-top: 30rpx;
  border-top: 1rpx dashed #eee;
}

.sub-question:first-child {
  margin-top: 10rpx;
  padding-top: 0;
  border-top: none;
}

.sub-question-number {
  font-size: 26rpx;
  color: #666;
  margin-right: 15rpx;
  min-width: 30rpx;
}

.sub-question-content {
  flex: 1;
}

.sub-question-text {
  font-size: 26rpx;
  color: #444;
  margin-bottom: 15rpx;
  line-height: 1.5;
}

/* 提交按钮样式（核心：文字居中） */
.submit-btn {
  margin: 50rpx 0 30rpx;
  width: 100%;
  height: 90rpx;
  /* 确保文字水平+垂直居中 */
  display: flex;
  justify-content: center;
  align-items: center;
  line-height: 1; /* 重置行高 */
  background: linear-gradient(135deg, #337ab7 0%, #286090 100%);
  color: white;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(51, 122, 183, 0.2);
  transition: all 0.2s ease;
}

.submit-btn:not([disabled]):hover {
  background: linear-gradient(135deg, #2d6bc7 0%, #23548a 100%);
  box-shadow: 0 8rpx 20rpx rgba(51, 122, 183, 0.25);
  transform: translateY(-2rpx);
}

.submit-btn:not([disabled]):active {
  transform: translateY(0);
  box-shadow: 0 4rpx 12rpx rgba(51, 122, 183, 0.2);
}
